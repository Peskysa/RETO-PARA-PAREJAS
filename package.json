{
  "name": "reto-para-parejas",
  "version": "2.0.0",
  "private": true,
  "description": "Propuestas compartidas con valoración individual y acuerdo voluntario.",
  "author": "Marco Pescador",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Peskysa/RETO-PARA-PAREJAS.git"
  },
  "scripts": {
    "test": "node --test tests/core.test.cjs",
    "build:web": "node scripts/build.cjs",
    "test:browser": "node tests/browser.cjs",
    "start": "node scripts/serve.cjs",
    "build:desktop": "electron-builder --publish never"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "io.github.peskysa.retoparaparejas",
    "productName": "Retos en pareja",
    "directories": {
      "output": "dist/desktop",
      "buildResources": "assets"
    },
    "files": [
      "desktop/main.cjs",
      "dist/web/**/*",
      "assets/icon-512.png",
      "project.json",
      "LICENSE",
      "NOTICE",
      "THIRD_PARTY.md",
      "licenses/**/*",
      "docs/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RETO-PARA-PAREJAS-Windows-Instalador.exe"
    },
    "portable": {
      "artifactName": "RETO-PARA-PAREJAS-Portable.exe"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "Utility",
      "maintainer": "Marco Pescador",
      "executableName": "reto-para-parejas",
      "artifactName": "RETO-PARA-PAREJAS-Linux-Portable.${ext}"
    },
    "deb": {
      "artifactName": "RETO-PARA-PAREJAS-Linux-amd64.deb"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
